@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
}

<h1>Импорт товаров из CSV</h1>

<form method="post" asp-controller="Products" asp-action="Import" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    
    <div class="mb-3">
        <label class="form-label">Путь к файлу</label>
        
        <div class="input-group mb-2">
            <input type="text" 
                   class="form-control" 
                   id="filePath" 
                   name="filePath" 
                   value="@Model.FilePath" 
                   placeholder="/csv/sample_products.csv"
                   onchange="document.getElementById('uploadedFile').value = ''" />
            <label class="btn btn-outline-secondary" for="uploadedFile">
                Обзор...
            </label>
            <input type="file" 
                   class="d-none" 
                   id="uploadedFile" 
                   name="uploadedFile" 
                   accept=".csv"
                   onchange="var fileName = this.files[0]?.name || ''; document.getElementById('filePath').value = fileName; document.getElementById('filePathText').value = '';" />
        </div>
        <div class="form-text">Введите путь вручную или нажмите "Обзор..." для выбора файла</div>
    </div>
    
    <button type="submit" class="btn btn-primary">Импортировать товары</button>
</form>

@if (Model.Result != null)
{
    <hr class="my-4" />
    <h2>Результат импорта</h2>
    
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Показатель</th>
                <th>Значение</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Всего строк</td>
                <td>@Model.Result.TotalRows</td>
            </tr>
            <tr>
                <td>Успешно импортировано</td>
                <td class="text-success"><strong>@Model.Result.ImportedCount</strong></td>
            </tr>
            <tr>
                <td>Ошибки</td>
                <td class="@(Model.Result.ErrorCount > 0 ? "text-danger" : "text-success")">
                    <strong>@Model.Result.ErrorCount</strong>
                </td>
            </tr>
        </tbody>
    </table>

    @if (Model.Result.Errors.Count > 0)
    {
        <h3 class="text-danger">Список ошибок</h3>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Строка</th>
                    <th>Описание ошибки</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in Model.Result.Errors)
                {
                    <tr>
                        <td>@error.RowNumber</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Index" class="btn btn-success mt-3">Перейти к списку товаров</a>
}
